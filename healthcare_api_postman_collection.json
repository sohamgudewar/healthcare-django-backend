            "url": {
              "raw": "{{base_url}}/api/doctors/{{sample_doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{sample_doctor_id}}", ""]
            },
            "description": "Delete a doctor profile from the system."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mappings",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('sample_mapping_id', json.data.id);",
                  "    }",
